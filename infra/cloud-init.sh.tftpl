#!/usr/bin/env bash
# startup script for the tasks VM. runs as root on first boot (and again on
# every boot, but the sentinel file makes everything past the first run a
# no-op).
set -euxo pipefail

SENTINEL=/var/lib/tasks-bootstrap-done
if [ -f "$SENTINEL" ]; then
  echo "tasks bootstrap already ran, skipping"
  exit 0
fi

# ---------------------------------------------------------------------------
# system packages
# ---------------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y --no-install-recommends \
  ca-certificates curl gnupg \
  ufw fail2ban unattended-upgrades \
  jq

# ---------------------------------------------------------------------------
# docker engine + compose plugin (official docker apt repo)
# debian's docker.io lags badly behind, so we use docker's repo directly
# ---------------------------------------------------------------------------
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg \
  | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo $${VERSION_CODENAME}) stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y --no-install-recommends \
  docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

# ---------------------------------------------------------------------------
# deploy user
# ---------------------------------------------------------------------------
if ! id -u ${deploy_user} >/dev/null 2>&1; then
  useradd -m -s /bin/bash ${deploy_user}
fi
usermod -aG docker ${deploy_user}

# passwordless sudo only for the few commands deploy needs (none right now;
# all docker access is via the docker group). leaving this commented in case
# we need it later for things like systemctl reload-or-restart.
# echo "${deploy_user} ALL=(ALL) NOPASSWD: /bin/systemctl restart caddy-tasks" \
#   > /etc/sudoers.d/${deploy_user}

# ssh keys come from GCE metadata (set by terraform).
# sshd already reads them, but the daemon defaults are too permissive.
# tighten: disable password auth, disable root login, force PubKey only.
sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/'      /etc/ssh/sshd_config
sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/'                    /etc/ssh/sshd_config
sed -i 's/^#*ChallengeResponseAuthentication.*/ChallengeResponseAuthentication no/' /etc/ssh/sshd_config
systemctl restart ssh

# ---------------------------------------------------------------------------
# app dir + production env file (root-owned, 0600 -- never readable by other)
# /opt/tasks is the deploy target; CI rsyncs compose.prod.yaml + Caddyfile +
# deploy.sh into here, then runs `docker compose -f compose.prod.yaml ...`.
# ---------------------------------------------------------------------------
mkdir -p /opt/tasks /opt/tasks/backups
chown -R ${deploy_user}:${deploy_user} /opt/tasks
chmod 750 /opt/tasks

cat > /opt/tasks/.env <<EOF
# generated by terraform on first boot. do not edit by hand --
# changes here will be lost on VM recreation.
POSTGRES_USER=tasks
POSTGRES_PASSWORD=${postgres_password}
POSTGRES_DB=tasks
DOMAIN=${domain}
ACME_EMAIL=${acme_email}
IMAGE_OWNER=${image_owner}
TAG=latest
EOF
# owned by deploy: the deploy script rewrites the TAG line on each release.
# the deploy user is already in the docker group (which is root-equivalent
# on this host), so giving them this file isn't widening the trust surface.
chown ${deploy_user}:${deploy_user} /opt/tasks/.env
chmod 600 /opt/tasks/.env

# ---------------------------------------------------------------------------
# firewall (host-side, in addition to the GCP firewall rules)
# ---------------------------------------------------------------------------
ufw default deny incoming
ufw default allow outgoing
ufw allow 22/tcp
ufw allow 80/tcp
ufw allow 443/tcp
ufw --force enable

# ---------------------------------------------------------------------------
# unattended-upgrades for security patches
# ---------------------------------------------------------------------------
dpkg-reconfigure -f noninteractive unattended-upgrades
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
EOF

# ---------------------------------------------------------------------------
# nightly db backup via systemd timer. keeps last 14 days inside the VM.
# stretch goal: rsync to a GCS bucket -- omitted to keep this short.
# ---------------------------------------------------------------------------
cat > /usr/local/bin/tasks-backup-db.sh <<'BACKUP'
#!/bin/sh
set -eu
TS=$(date -u +%Y-%m-%dT%H-%M-%SZ)
OUT=/opt/tasks/backups/tasks-$TS.sql.gz
docker exec tasks-postgres-1 pg_dump -U tasks tasks | gzip > "$OUT"
# retain last 14
find /opt/tasks/backups -name 'tasks-*.sql.gz' -mtime +14 -delete
BACKUP
chmod +x /usr/local/bin/tasks-backup-db.sh

cat > /etc/systemd/system/tasks-backup-db.service <<'EOF'
[Unit]
Description=Dump the tasks postgres database to /opt/tasks/backups
[Service]
Type=oneshot
ExecStart=/usr/local/bin/tasks-backup-db.sh
EOF

cat > /etc/systemd/system/tasks-backup-db.timer <<'EOF'
[Unit]
Description=Nightly tasks DB backup
[Timer]
OnCalendar=*-*-* 03:00:00
Persistent=true
[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload
systemctl enable --now tasks-backup-db.timer

# ---------------------------------------------------------------------------
# done. write sentinel so reboots short-circuit.
# ---------------------------------------------------------------------------
touch "$SENTINEL"
echo "tasks bootstrap complete"
