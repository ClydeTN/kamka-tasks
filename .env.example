# copy this to .env and fill in real values.
# the real .env is gitignored -- never commit secrets.

# --- database -------------------------------------------------------
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# --- host port bindings (dev only) ----------------------------------
# only the compose.override.yaml reads these. change if a port is busy.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=8080
