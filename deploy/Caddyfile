# caddy auto-tls via let's encrypt. caddy persists certs in the caddy_data
# volume so renewals survive restarts.
{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode gzip zstd

  # api lives under /api -- the routes inside the api are already prefixed
  reverse_proxy /api/* api:4000

  # everything else hits the nginx-served react bundle
  reverse_proxy web:80
}

# uptime kuma on its own subdomain (nip.io maps any sub.<ip>.nip.io to the
# same ip, so this works out of the box without extra dns)
status.{$DOMAIN} {
  encode gzip zstd
  reverse_proxy uptime:3001
}
